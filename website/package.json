		"@types/pg": "^8.16.0",
		"dotenv": "^17.3.1",
		"drizzle-kit": "^0.31.9",
		"sass-embedded": "^1.97.3",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.4",
